# Xcode project files (project.pbxproj should be committed, but user-specific parts shouldn't)
*.xcworkspace
!default.xcworkspace # 可选：如果你有固定的工作区配置

# User-specific data and settings
*.xcuserstate
*.pbxuser
*.mode1v3
*.mode2v3
xcuserdata/

# Build products
build/
DerivedData/
Products/

# Logs and misc
*.log
*.sqldb
*.sym
*.swp
*~
.#*

# CocoaPods
Pods/
Podfile.lock
!Podfile

# Carthage
Carthage/Build/
Carthage/Checkouts/

# Swift Package Manager
.swiftpm/xcode-backup/

# Fastlane
fastlane/logs/

# xcresult bundles
*.xcresult

# Documentation & playgrounds
*.playgroundbook
*.playground
Documentation/

# Simulator logs
Library/Developer/CoreSimulator

# App Store Connect API keys (if any)
private_keys/

# Environment files (used for config, e.g. .env)
.env*
!.env.example

# Other IDEs / editor files
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# macOS system files
.DS_Store
._*
.Spotlight-V100
.Trashes